# Filesystem and service
APP_HOST=127.0.0.1
APP_PORT=3000
APP_DATA_DIR=./data
APP_DATABASE_PATH=./data/bill-ledger.sqlite
APP_LOG_LEVEL=info
# Each Compose project needs a unique CUSTOMER_ID and APP_PORT. Set CUSTOMER_ENV_FILE
# and CUSTOMER_SECRETS_DIR in the Compose command (see README).
# CUSTOMER_ID=acme
# Read-only central monitoring token; use a different random 32+ character value per customer.
# MONITOR_TOKEN=

# WhatsApp ingestion
WHATSAPP_ENABLED=false
# Leave unset to keep WhatsApp connected without ingesting any group.
# WHATSAPP_GROUP_ID=replace-with-group-id
WHATSAPP_AUTH_PATH=./data/whatsapp-auth

# Shared immutable originals. WHATSAPP_ORIGINALS_DIR remains a legacy fallback.
ORIGINALS_DIR=./data/originals
# WHATSAPP_ORIGINALS_DIR=./data/originals
MAX_ATTACHMENT_BYTES=20971520

# Telegram Bot API long polling. Keep the BotFather token only in the untracked .env.
TELEGRAM_ENABLED=true
# Required only when TELEGRAM_ENABLED=true.
TELEGRAM_BOT_TOKEN=
#Comma-separated signed decimal chat IDs; whitespace and duplicates are removed.
# An empty list still polls Telegram but ingests no chats.
TELEGRAM_GROUP_IDS=-
# Integer seconds, minimum 1.
TELEGRAM_POLL_TIMEOUT_SECONDS=30
# Integer milliseconds, minimum 1 and strictly greater than the poll timeout.
TELEGRAM_REQUEST_TIMEOUT_MS=35000
# Maximum bytes for each Bot API JSON response, integer minimum 1.
TELEGRAM_MAX_RESPONSE_BYTES=2097152

# Set false to use Azure as the only extraction provider.
MISTRAL_ENABLED=false
# MISTRAL_API_KEY=replace-with-secret
# MISTRAL_MODEL=mistral-ocr-latest
# MISTRAL_MAX_RESPONSE_BYTES=2097152
# MISTRAL_REQUEST_TIMEOUT_MS=60000

# Azure Document Intelligence is the primary provider when MISTRAL_ENABLED=false and is required for admin ZIP uploads.
# AZURE_ENABLED defaults to true. When true, the endpoint and API key below are required; keep both private.
AZURE_ENABLED=true
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://replace-with-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=replace-with-secret
# Integer bytes, minimum 1 (default 2097152 / 2 MiB).
AZURE_MAX_RESPONSE_BYTES=2097152
# Integer milliseconds, minimum 1 (default 60000).
AZURE_REQUEST_TIMEOUT_MS=60000
# Integer milliseconds, minimum 0 (default 500).
AZURE_POLL_INTERVAL_MS=500
# Number from 0 through 1 inclusive (default 0.80).
OCR_FALLBACK_CONFIDENCE_THRESHOLD=0.80

# Admin ZIP uploads have no ZIP environment variables. Their fixed service limits are
# 50 MiB compressed, 200 MiB expanded, 20 MiB per entry, and 500 entries per ZIP.

# In-memory OCR photo derivative. Originals are never modified or stored as derivatives.
IMAGE_PREPROCESSING_ENABLED=false
IMAGE_PREPROCESSING_TIMEOUT_MS=8000

# Google projections. Select exactly one authentication mode.
GOOGLE_ENABLED=true
# service_account is the backwards-compatible default. It must access both resources.
GOOGLE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
# For GOOGLE_AUTH_MODE=user_oauth, use the downloaded OAuth Desktop app client as input.
# GOOGLE_OAUTH_CLIENT_JSON=./secrets/google-oauth-client.json
# Set this to a new, nonexistent private output, then run `bun run google:oauth` locally.
# GOOGLE_OAUTH_CREDENTIAL_JSON=./secrets/google-authorized-user.json
GOOGLE_DRIVE_FOLDER_ID=replace-with-folder-id
GOOGLE_SHEET_ID=replace-with-sheet-id
GOOGLE_SHEET_NAME=Ledger
GOOGLE_REQUEST_TIMEOUT_MS=60000
GOOGLE_MAX_RESPONSE_BYTES=2097152

# Review UI
REVIEW_USERNAME=reviewer
REVIEW_PASSWORD=replace-with-secret
# Required by multi-customer Compose. Distinct HTTPS hostname per customer,
# no port or trailing slash; TLS proxy must preserve Host. Unset for single-instance local dev.
# REVIEW_ORIGIN=https://acme.bills.example.com

# Validation and job retry policy
CURRENCY_ROUNDING_TOLERANCE=0.01
MAX_FUTURE_INVOICE_DAYS=30
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_MS=1000
JOB_RETRY_MAX_MS=300000
JOB_LEASE_MS=60000
