# Filesystem and service
APP_HOST=127.0.0.1
APP_PORT=3000
APP_DATA_DIR=./data
APP_DATABASE_PATH=./data/bill-ledger.sqlite
APP_LOG_LEVEL=info

# WhatsApp ingestion
WHATSAPP_ENABLED=true
# Leave unset to keep WhatsApp connected without ingesting any group.
# WHATSAPP_GROUP_ID=replace-with-group-id
WHATSAPP_AUTH_PATH=./data/whatsapp-auth
WHATSAPP_ORIGINALS_DIR=./data/originals
MAX_ATTACHMENT_BYTES=20971520

# Set false to use Azure as the only extraction provider.
MISTRAL_ENABLED=false
# MISTRAL_API_KEY=replace-with-secret
# MISTRAL_MODEL=mistral-ocr-latest
# MISTRAL_MAX_RESPONSE_BYTES=2097152
# MISTRAL_REQUEST_TIMEOUT_MS=60000

# Azure Document Intelligence is the primary provider when MISTRAL_ENABLED=false.
# Keep the endpoint as an HTTPS origin and store the API key only in this private environment file.
AZURE_ENABLED=true
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://replace-with-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=replace-with-secret
AZURE_MAX_RESPONSE_BYTES=2097152
AZURE_REQUEST_TIMEOUT_MS=60000
AZURE_POLL_INTERVAL_MS=500
OCR_FALLBACK_CONFIDENCE_THRESHOLD=0.80

# In-memory OCR photo derivative. Originals are never modified or stored as derivatives.
IMAGE_PREPROCESSING_ENABLED=false
IMAGE_PREPROCESSING_TIMEOUT_MS=8000

# Google projections. Select exactly one authentication mode.
GOOGLE_ENABLED=true
# service_account is the backwards-compatible default. It must access both resources.
GOOGLE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
# For GOOGLE_AUTH_MODE=user_oauth, create this file locally with `bun run google:oauth`.
# GOOGLE_OAUTH_CREDENTIAL_JSON=./secrets/google-authorized-user.json
GOOGLE_DRIVE_FOLDER_ID=replace-with-folder-id
GOOGLE_SHEET_ID=replace-with-sheet-id
GOOGLE_SHEET_NAME=Ledger
GOOGLE_REQUEST_TIMEOUT_MS=60000
GOOGLE_MAX_RESPONSE_BYTES=2097152

# Review UI
REVIEW_USERNAME=reviewer
REVIEW_PASSWORD=replace-with-secret

# Validation and job retry policy
CURRENCY_ROUNDING_TOLERANCE=0.01
MAX_FUTURE_INVOICE_DAYS=30
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_MS=1000
JOB_RETRY_MAX_MS=300000
JOB_LEASE_MS=60000
