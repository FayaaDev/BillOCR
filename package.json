{
  "name": "bill-ledger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/server.ts src/ops.ts --target bun --outdir dist",
    "verify-build": "bun run build && test -f dist/server.js && test -f dist/ops.js",
    "ops": "bun run src/ops.ts",
    "migrate": "bun run src/ops.ts migrate",
    "whatsapp:qr": "bun run src/render-whatsapp-qr.ts",
    "google:oauth": "bun run src/google-oauth.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "qrcode-terminal": "^0.12.0"
  }
}
