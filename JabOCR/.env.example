# Public DNS hostname only: no scheme, port, or trailing slash.
APP_DOMAIN=bills.example.com
CADDY_EMAIL=admin@example.com

# Use your own credentials. Single-quote secrets containing $ or #.
REVIEW_USERNAME=reviewer
REVIEW_PASSWORD='replace-with-a-long-random-password'
APP_LOG_LEVEL=info

# Azure Document Intelligence (required). Compose enforces Azure-only OCR.
MISTRAL_ENABLED=false
AZURE_ENABLED=true
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://replace-with-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_API_KEY='replace-with-azure-key'
IMAGE_PREPROCESSING_ENABLED=false

# Dashboard ZIP upload is always available. Enable other inputs after setup.
WHATSAPP_ENABLED=false
# Pair first, then set the intended group ID and recreate the app.
# WHATSAPP_GROUP_ID=1234567890@g.us

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated signed decimal chat IDs. Empty means no chats ingested.
TELEGRAM_GROUP_IDS=

# Optional Google archive and ledger. Paths are inside the container.
GOOGLE_ENABLED=false
GOOGLE_AUTH_MODE=user_oauth
GOOGLE_OAUTH_CREDENTIAL_JSON=/run/secrets/google-authorized-user.json
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Ledger

# Optional Saudi Zoho archive and ledger. Disable Google when switching to Zoho.
ZOHO_ENABLED=false
ZOHO_REGION=sa
ZOHO_OAUTH_CREDENTIAL_JSON=/run/secrets/zoho-authorized-user.json
ZOHO_WORKDRIVE_FOLDER_ID=
ZOHO_SHEET_RESOURCE_ID=
ZOHO_SHEET_NAME=Ledger
